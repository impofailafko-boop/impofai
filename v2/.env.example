# ImpofAI V2 Environment Configuration

# Application
NODE_ENV=development
PORT=3002

# ElevenLabs Configuration
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_AGENT_ID=your-agent-id-here

# Webhook Security
WEBHOOK_SECRET=your-webhook-secret-here-min-32-chars

# Database
AGENTDB_PATH=./data/agentdb.sqlite

# Security
API_SECRET_KEY=your-api-secret-key-here-min-32-chars
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3000

# Configuration
DEFAULT_LANGUAGE=sk-SK
NIGHTLY_LEARNING_HOUR=2

# Optional: Logging
LOG_LEVEL=info

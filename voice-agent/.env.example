# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Worker ID (for testing - in production this would come from login)
WORKER_ID=W001

# Dashboard Configuration
DASHBOARD_PORT=3000

# Analytics Database (optional - defaults to in-memory)
# DATABASE_URL=postgresql://user:pass@localhost:5432/business_voice

# Business System Integrations (optional)
# ISSUE_TRACKING_API=https://your-issue-tracker.com/api
# INVENTORY_API=https://your-inventory-system.com/api

# Debug Mode
DEBUG=true
